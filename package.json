{
  "name": "stylegrab",
  "description": "Capture colour palettes and typography from any website and export them as CSS variables, Tailwind config, SCSS or W3C design tokens.",
  "license": "MIT",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "node scripts/e2e.mjs",
    "e2e:capture": "node scripts/e2e-capture.mjs",
    "e2e:flow": "node scripts/e2e-flow.mjs",
    "e2e:all": "npm run e2e && npm run e2e:capture && npm run e2e:flow",
    "gif": "node scripts/make-gif.mjs",
    "shots": "node scripts/make-shots.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "preact": "^10.24.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.2.2",
    "@vitest/coverage-v8": "^4.1.10",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "playwright": "^1.61.1",
    "typescript": "^5.6.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wxt": "^0.20.27"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "tar": "^7.5.20",
    "tmp": "^0.2.7",
    "adm-zip": "^0.6.0",
    "shell-quote": "^1.10.0",
    "uuid": "^14.0.1",
    "esbuild": "^0.28.1"
  }
}
